<Project>
  <!--
    Shared settings for the patcher and tools/harness.
    BepInExCore must point at a BepInEx 5 "core" folder (it holds BepInEx.dll and Mono.Cecil.dll).
    The default is Gale's Default profile for Stonewards. To use another folder, pass
    -p:BepInExCore=<path> to dotnet build, or set it in a git-ignored Directory.Build.props.user.
  -->
  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />
  <PropertyGroup>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(APPDATA)\com.kesomannen.gale\stonewards\profiles\Default\BepInEx\core</BepInExCore>
  </PropertyGroup>
</Project>
